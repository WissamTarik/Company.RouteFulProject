@model int
<td style="width:150px">
    <a asp-action="Details" class="btn btn-warning d-flex w-full align-items-center" asp-route-id="@Model">
        <i class="fa-solid fa-eye me-2"></i>
        Details

    </a>
</td>
<td style="width:150px">
    <a asp-action="Edit" class="btn btn-success d-flex w-full align-items-center" asp-route-id="@Model">

        <i class="fas fa-pen me-2"></i>
        Edit
    </a>
</td>
<td style="width:150px">
    <a asp-action="Delete" asp-route-id="@Model" class="btn btn-danger d-flex w-full align-items-center">
        <i class="fas fa-trash me-2"></i>
        Delete
    </a>
</td>