<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Company.RouteFulProjectPL</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/font-awesome/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Company.RouteFulProjectPL.styles.css" asp-append-version="true" />
</head>
<body data-bs-spy="scroll" data-bs-target="#Navbar">
    <header>
        <nav class="navbar navbar-expand-md navbar-toggleable-sm bg-dark text-bg-dark fixed-top border-bottom box-shadow mb-3" id="Navbar">
            <div class="container  text-white">
                <a class="navbar-brand text-white fw-bold d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="fs-3 me-2"> <i class="fa-solid fa-building"></i></span>
                    
                    Route Company</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <i class="fas fa-bars text-white"></i>
                </button>
                <div class="navbar-collapse collapse d-md-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1  justify-content-center">
                        <li class="nav-item">
                            <a class="nav-link text-white active" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white " asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-controller="Department" asp-action="Index">Departments</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-controller="Employee" asp-action="Index">Employees</a>
                        </li>
                    </ul>
                
                    <div class="d-flex flex-md-row flex-column ">
                        <a class="btn btn-success rounded-pill me-md-2 mb-2 mb-md-0 " asp-action="Login" asp-controller="Auth">Login</a>
                        <a class="btn btn-danger rounded-pill " asp-action="Log Out" asp-controller="Auth">Log Out</a>
                    </div>

                </div>
            </div>
        </nav>
    </header>
    <div class="container ">
        <main role="main" class="pb-3 pt-3 min-vh-100 mt-5">
            @RenderBody()
        </main>
    </div>
    <input type="hidden" id="TempDataMessage"
           value="@TempData["Message"]"
           data-icon="@TempData["MessageIcon"]"
           data-title="@TempData["MessageTitle"]" />
    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - Company.RouteFulProjectPL - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("ValidationSection", required: false)
</body>
</html>
