@model Department
@{
    ViewData["Title"] = "Details";
}

<div class="card w-75 mx-auto shadow-lg mt-3 rounded-3 " id="Department">
    <div class="card-header bg-primary w-100  px-3 text-white  py-3  ">
        <h2 class="position-static  ">Department Details</h2>
    </div>
    <div class="card-body">
        <div>
            <partial name="DepartmentPartialView/_DetailsAndDeletePartialView" />
            @* <div class="form-floating mb-3">
              <input asp-for="Code" placeholder="" class="form-control" readonly/>
              <label asp-for="Code"></label>
            </div>
            <div class="form-floating mb-3">
               <input asp-for="Name" placeholder="" class="form-control" readonly/>
               <label asp-for="Name"></label>
            </div>
            <div class="form-floating mb-3">
               <input asp-for="CreatedAt" placeholder="" class="form-control" readonly/>
               <label asp-for="CreatedAt">Date of Creation</label>
            </div> *@
             
            @if (Model.Employees.Count() > 0)
            {
              <div class="table-responsive">
                  <p class="fw-bold ">Employees data:</p>
                    <table class="table table-striped table-bordered  table-light text-center align-middle">
                        <thead class="table-info">
                            <tr>
                                <th>Name</th>
                                <th>Age</th>
                                <th>Email</th>
                                <th>Salary</th>

                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Employees)
                            {
                                <tr>
                                    <td>@item.Name</td>
                                    <td>@item.Age</td>
                                    <td>@item.Email</td>
                                    <td>@item.Salary</td>
                                </tr>
                            }
                        </tbody>
                    </table>
              </div>
            }

            <a asp-action="Edit" class="btn btn-warning" asp-route-id="@Model.Id">
                Edit
                <i class="fas fa-pen  ms-2"></i>
            </a>
            <a class="btn btn-light ms-2" asp-action="Index">
                Back to list

                <i class="fas fa-arrow-right ms-2"></i>
            </a>
        </div>
    </div>
</div>


