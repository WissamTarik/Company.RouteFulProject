@model Department
@{
    ViewData["Title"] = "Delete";
}
<form asp-action="Delete">


    <div class="card w-75 mx-auto shadow-lg mt-3 rounded-3 " id="Department">
        <div class="card-header bg-primary w-100  px-3 text-white  py-3  ">
            <h2 class="position-static  ">Delete Department </h2>
        </div>
        <div class="card-body">
            <div>
                <partial name="DepartmentPartialView/_DetailsAndDeletePartialView" />
                @* <div class="form-floating mb-3">
                    <input asp-for="Code" class="form-control" placeholder="" readonly />
                    <label asp-for="Code" class="form-label"></label>
                </div>
                <div class="form-floating mb-3">
                    <input asp-for="Name" class="form-control" placeholder="" readonly />
                    <label asp-for="Name" class="form-label"></label>
                </div>
                <div class="form-floating mb-3">
                    <input asp-for="CreatedAt" class="form-control" placeholder="" readonly />
                    <label asp-for="CreatedAt">Date of creation</label>
                </div> *@
                <button type="button" data-bs-toggle="modal" data-bs-target="#deleteModal"  class="btn btn-danger">Delete</button>
                 
                <a class="btn btn-light ms-2" asp-action="Index">
                    Back to list

                    <i class="fas fa-arrow-right ms-2"></i>
                </a>
            </div>
        </div>
    </div>

    <div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">Confirm Delete</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    Are you sure to Delete Employee @Model.Name?
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Yes, Delete</button>
                </div>
            </div>
        </div>
    </div>

</form>

