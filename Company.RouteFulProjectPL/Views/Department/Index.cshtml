
@model IEnumerable<Department>
@{
    ViewData["Title"] = "Index";
    var Message = TempData["Message"] as string;
}

<div class="w-75 mx-auto" id="Department">
    <h1 class="position-relative">All Departments</h1>
   
    @if (Model.Count() > 0)
    {

        <div class="mt-5">
            <div class="container">
                @if(!string.IsNullOrEmpty(TempData["Message"]  as string))
                {
                    <div class="alert alert-info alert-dismissible fade show" role="alert">
                        <strong>@TempData["Message"]</strong>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                <div class="my-5 row  g-3 justify-content-between">
                    <form class="   col-12 col-sm-6" asp-action="Index">
                        <div class="row g-0">

                            <div class="col-sm-9">
                                <input type="search" name="SearchName" id="SearchInput" class="form-control  " placeholder="Search by name..." />
                            </div>
                            <button class="btn btn-secondary py-2 col-sm-3">Search</button>
                        </div>
                    </form>
                    <a class="btn btn-primary text-capitalize col-12 col-sm-3  py-2" asp-action="Create">
                        <i class="fas fa-plus"></i>
                        Create Department
                    </a>
                </div>
            </div>
            <table class="table table-hover table-striped text-center ">

                <thead class="table-dark fw-bold">
                    <tr>
                        <td>Code</td>
                        <td>Name</td>
                        <td>CreatedAt</td>
                        <td>Details</td>
                        <td>Update</td>
                        <td>Delete</td>
                    </tr>
                </thead>

                <tbody>
                    @foreach(var item in Model)
                    {
                        <tr>
                            <td>@item.Code</td>
                            <td>@item.Name</td>
                            <td>@item.CreatedAt</td>
                            <partial name="_ButtonsPartialView" model="@item.Id.ToString()" />
                            @* <td>
                                <a asp-action="Details" class="btn btn-warning" asp-route-id="@item.Id">
                                    <i class="fa-solid fa-eye me-2"></i>
                                    Details

                                </a>
                            </td>
                            <td>
                                <a asp-action="Edit" class="btn btn-success" asp-route-id="@item.Id">

                                    <i class="fas fa-pen me-2"></i>
                                    Edit
                                </a>
                            </td>
                            <td>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger">
                                    <i class="fas fa-trash me-2"></i>
                                    Delete
                                </a>
                            </td> *@
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else{
    <div class="card text-center shadow-sm p-5  mt-5 pt-3">
        <div class="card-body">
                <i class="fa-solid fa-face-sad-cry  fa-4x text-secondary mb-3"></i>
            <h4 class="fw-bold text-muted">No Departments Found</h4>
            <p class="text-muted">It looks like you haven’t added any departments yet.</p>
            <a asp-action="Create" class="btn btn-primary mt-3">
                <i class="fa-solid fa-plus"></i> Create Department
            </a>
        </div>
    </div>
    }
    


</div>

