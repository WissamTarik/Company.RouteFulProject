

@model CreateDepartmentDto
 
@{
    ViewData["Title"] = "Create";
}


<div class="card w-75 mx-auto shadow-lg mt-3 rounded-3 ">
    <div class="card-header bg-primary w-100  px-3 text-white  py-3  ">
        <h2 class="position-static  ">Create Department</h2>
    </div>
    <div class="card-body">
      <form asp-action="Create">
          <div class="form-floating mb-3">
              <input placeholder=""  asp-for="Code" class="form-control" />
              <label asp-for="Code">Code</label>
          <span asp-validation-for="Code" class="text-danger"></span>
          </div>
          <div class="form-floating mb-3">
              <input placeholder=""  asp-for="Name" class="form-control" />
              <label asp-for="Name">Name</label>
              <span asp-validation-for="Name" class="text-danger"></span>
          </div>
          <div class="form-floating mb-3">
              <input placeholder=""  asp-for="CreatedAt" class="form-control" />
              <label asp-for="CreatedAt">CreatedAt</label>
              <span asp-validation-for="CreatedAt" class="text-danger"></span>
          </div>
          <input type="submit" class="btn btn-success" value="Create"/>
          <a class="btn btn-light ms-2" asp-action="Index">Back to list

              <i class="fas fa-arrow-right ms-2"></i>
          </a>
      </form>
    </div>
</div>

