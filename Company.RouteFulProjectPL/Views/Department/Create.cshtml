

@model CreateDepartmentDto
 
@{
    ViewData["Title"] = "Create";
}


<div class="card w-75 mx-auto shadow-lg mt-3 rounded-3 " id="Department">
    <div class="card-header bg-primary w-100  px-3 text-white  py-3  ">
        <h2 class="position-static  ">Create Department</h2>
    </div>
    <div class="card-body">
      <form asp-action="Create">
            <partial name="DepartmentPartialView/_CreateAndEditPartialView" />
          <input type="submit" class="btn btn-success" value="Create"/>
          <a class="btn btn-light ms-2" asp-action="Index">Back to list

              <i class="fas fa-arrow-right ms-2"></i>
          </a>
      </form>
    </div>
</div>

@section ValidationSection{
    <partial name="_ValidationScriptsPartial" />
}