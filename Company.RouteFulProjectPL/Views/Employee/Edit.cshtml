@model EmployeeDto
@{
    ViewData["Title"] = "Edit";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-lg border-0 rounded-3">
                <div class="card-header bg-dark text-white text-center">
                    <h4> Edit Employee @Model.Name</h4>
                </div>

    <div class="card-body">
        <form asp-action="Edit" enctype="multipart/form-data">
            <input hidden asp-for="ImageName"/>
            <partial name="EmployeePartialView/_CreateEditPartialView" />
            @* <div class="form-floating mb-3">
                <input placeholder="" asp-for="Name" class="form-control" />
                <label asp-for="Name">Name</label>
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-floating mb-3">
                <input placeholder="" asp-for="Age" class="form-control" />
                <label asp-for="Age">Age</label>
                <span asp-validation-for="Age" class="text-danger"></span>
            </div>
            <div class="form-floating mb-3">
                <input placeholder="" asp-for="Email" class="form-control" />
                <label asp-for="Email">Email</label>
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="form-floating mb-3">
                <input placeholder="" asp-for="Address" class="form-control" />
                <label asp-for="Address" class="form-label"></label>
                <span asp-validation-for="Address" class="text-danger"></span>
            </div>
            <div class="form-floating mb-3">
                <input placeholder="" asp-for="Phone" class="form-control" />
                <label asp-for="Phone" class="form-label"></label>
                <span asp-validation-for="Phone" class="text-danger"></span>
            </div>
            <div class="form-floating mb-3">
                <input placeholder="" asp-for="Salary" class="form-control" />
                <label asp-for="Salary" class="form-label"></label>
                <span asp-validation-for="Salary" class="text-danger"></span>
            </div>

            <div class="form-check  form-check-inline mb-2">
                <input class="form-check-input" type="checkbox" asp-for="IsActivated" role="switch">
                <label class="form-check-label" asp-for="IsActivated"></label>
            </div>
            <div class="form-check form-check-inline mb-2">
                <input class="form-check-input" type="checkbox" asp-for="IsDeleted" >
                <label class="form-check-label" asp-for="IsDeleted"></label>
            </div>

            <div class="form-floating mb-3">
                <input placeholder="" asp-for="HiringDate" class="form-control" />
                <label asp-for="HiringDate">Date Of Hiring</label>
                <span asp-validation-for="HiringDate" class="text-danger"></span>
            </div>

            <div class="form-floating mb-3">
                <input placeholder="" asp-for="CreatedAt" class="form-control" />
                <label asp-for="CreatedAt">Date Of Creation</label>
                <span asp-validation-for="CreatedAt" class="text-danger"></span>
            </div> *@
                        <div class="d-grid">
                            <button type="submit" class="btn btn-success" asp-action="Edit">
                                <i class="fas fa-save me-3"></i> Save
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary mt-2">Return to Employee  List
                                <i class="fas fa-arrow-right ms-2"></i>

                            </a>
                        </div>
        </form>
    </div>
</div>
</div>
</div>
</div>
@section ValidationSection{
     <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
     <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
}

