
@model EmployeeDto
@inject IDepartmentRepository _departmentRepository;
@{
    // var Departments = new SelectList(ViewData["departments"] as IEnumerable<Department>,"Id","Name");
    var Departments = new SelectList( await _departmentRepository.GetAllAsync(),"Id","Name");
}
<div class="form-floating mb-3">
    <input placeholder="" asp-for="Name" class="form-control" />
    <label asp-for="Name">Name</label>
    <span asp-validation-for="Name" class="text-danger"></span>
</div>
<div class="form-floating mb-3">
    <input placeholder="" asp-for="Age" class="form-control" />
    <label asp-for="Age">Age</label>
    <span asp-validation-for="Age" class="text-danger"></span>
</div>
<div class="form-floating mb-3">
    <input placeholder="" asp-for="Email" class="form-control" />
    <label asp-for="Email">Email</label>
    <span asp-validation-for="Email" class="text-danger"></span>
</div>
<div class="form-floating mb-3">
    <input placeholder="" asp-for="Address" class="form-control" />
    <label asp-for="Address" class="form-label"></label>
    <span asp-validation-for="Address" class="text-danger"></span>
</div>
<div class="form-floating mb-3">
    <input placeholder="" asp-for="Phone" class="form-control" />
    <label asp-for="Phone" class="form-label"></label>
    <span asp-validation-for="Phone" class="text-danger"></span>
</div>
<div class="form-floating mb-3">
    <input placeholder="" asp-for="Salary" class="form-control" />
    <label asp-for="Salary" class="form-label"></label>
    <span asp-validation-for="Salary" class="text-danger"></span>
</div>

<div class="form-check form-switch form-check-inline mb-2">
    <input class="form-check-input" type="checkbox" asp-for="IsActivated" role="switch">
    <label class="form-check-label" asp-for="IsActivated"></label>
</div>
<div class="form-check form-switch mb-2 form-check-inline">
    <input class="form-check-input" type="checkbox" asp-for="IsDeleted" role="switch">
    <label class="form-check-label" asp-for="IsDeleted"></label>
</div>

<div class="form-floating mb-3">
    <input placeholder="" asp-for="HiringDate" class="form-control" />
    <label asp-for="HiringDate"></label>
    <span asp-validation-for="HiringDate" class="text-danger"></span>
</div>

<div class="form-floating mb-3">
    <input placeholder="" asp-for="CreatedAt" class="form-control" />
    <label asp-for="CreatedAt"></label>
    <span asp-validation-for="CreatedAt" class="text-danger"></span>
</div>
<div class=" mb-3">
    <input placeholder="" asp-for="Image" class="form-control"  />
    <label asp-for="Image" ></label>
</div>

<div class="form-floating mb-3">
    <select asp-for="DepartmentId" asp-items="Departments" class="form-select" >
        <option value="@null" >--Select Department--</option>
</select>
    <label asp-for="DepartmentId"></label>
</div>
