
@model Employee
<div class="form-floating mb-3">
    <input asp-for="Name" placeholder="" class="form-control" readonly />
    <label asp-for="Name"></label>
</div>
<div class="form-floating mb-3">
    <input asp-for="Age" placeholder="" class="form-control" readonly />
    <label asp-for="Age"></label>
</div>
<div class="form-floating mb-3">
    <input asp-for="Email" placeholder="" class="form-control" readonly />
    <label asp-for="Email"></label>
</div>
<div class="form-floating mb-3">
    <input asp-for="Address" placeholder="" class="form-control" readonly />
    <label asp-for="Address"></label>
</div>
<div class="form-floating mb-3">
    <input asp-for="Phone" placeholder="" class="form-control" readonly />
    <label asp-for="Phone"></label>
</div>
<div class="form-floating mb-3">
    <input asp-for="Salary" placeholder="" class="form-control" readonly />
    <label asp-for="Salary"></label>
</div>
<div class="form-check  form-check-inline mb-2">
    <input class="form-check-input" type="checkbox" asp-for="IsActivated" disabled>
    <label class="form-check-label" asp-for="IsActivated"></label>
</div>
<div class="form-check  form-check-inline mb-2">
    <input class="form-check-input" type="checkbox" asp-for="IsDeleted" disabled>
    <label class="form-check-label" asp-for="IsDeleted"></label>
</div>


<div class="form-floating mb-3">
    <input asp-for="HiringDate" placeholder="" class="form-control" readonly />
    <label asp-for="HiringDate">Date of Hiring</label>
</div>
<div class="form-floating mb-3">
    <input asp-for="CreatedAt" placeholder="" class="form-control" readonly />
    <label asp-for="CreatedAt">Date of Creation</label>
</div>