@model IEnumerable<Employee> 
@{
    ViewData["Title"] = "Index";
}

<section id="Employee" class="mx-auto" >
    <h1 class="position-relative">All Employees</h1>
    @if (Model.Count() > 0)
    {

        <div class="mt-5 table-responsive">
            <a asp-action="Create" class="btn btn-primary my-3 d-block width-fit ms-auto ">
                <i class="fa-solid fa-plus"></i> Create Employee
            </a>
            <table class="table table-hover table-striped text-center ">

                <thead class="table-dark fw-bold">
                    <tr>
                        <td>Name</td>
                        <td>Age</td>
                        <td>Email</td>
                        <td>Address</td>
                        <td>Phone</td>
                        <td>Salary</td>
                        <td>IsActivated</td>
                        <td>IsDeleted</td>
                        <td>@Html.DisplayNameFor(e=>e.HiringDate)</td>
                        <td>@Html.DisplayNameFor(e=>e.CreatedAt)</td>
                        <td>Details</td>
                        <td>Update</td>
                        <td>Delete</td>
                    </tr>
                </thead>

                <tbody>
                    @foreach(var item in Model)
                    {
                        <tr>
                            <td>@item.Name</td>
                            <td>@item.Age</td>
                            <td>@item.Email</td>
                            <td>@item.Address</td>
                            <td>@item.Phone</td>
                            <td>@item.Salary</td>
                            <td>@item.IsActivated</td>
                            <td>@item.IsDeleted</td>
                            <td>@item.HiringDate.Month-@item.HiringDate.Year</td>
                            <td>@item.CreatedAt.Month-@item.CreatedAt.Year</td>

                            <partial name="_ButtonsPartialView" model="@item.Id" />
                            @* <td>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-warning">

                                    Details
                                </a>
                            </td>
                            <td>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-success">

                                    Edit
                                </a>
                            </td>
                            <td>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger">

                                    Delete
                                </a>
                            </td> *@
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="card text-center shadow-sm p-5  mt-5 pt-3">
            <div class="card-body">
                <i class="fa-solid fa-face-sad-cry  fa-4x text-secondary mb-3"></i>
                <h4 class="fw-bold text-muted">No Employee Found</h4>
                <p class="text-muted">It looks like you haven’t added any employees yet.</p>
                <a asp-action="Create" class="btn btn-primary mt-3">
                    <i class="fa-solid fa-plus"></i> Create Employee
                </a>
            </div>
        </div>
    }



</section>

