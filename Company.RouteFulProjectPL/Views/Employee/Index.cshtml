@model IEnumerable<Employee> 
@{
    ViewData["Title"] = "Index";
    // string ?MessageViewData = ViewData["Message"].Message as string;
    // string MessageViewBag = ViewBag.Message.Message;
    // string? Message = TempData["Message"] as string;
}

<section id="Employee" class="mx-auto mt-5 pt-3" >
    <h1 class=" pt-5 mt-5">All Employees</h1>

    @* <div class="mt-3 alert alert-danger">
        <p>@MessageViewData</p>
    </div> *@

    @* <div class="mt-3 alert alert-warning">
        <p>@MessageViewBag</p>
    </div> *@

    @* @if (!string.IsNullOrEmpty(Message))
    {
        <div class="mt-3 alert alert-info">
            <p>@Message</p>
        </div>
    } *@
    @if (Model.Count() > 0)
    {

        <div class="mt-5">
          <div class="container">
                <div class="my-5 row  g-3 justify-content-between">
                    <form class="   col-12 col-sm-6">
                       <div class="row g-0">

                            <div class="col-sm-9">
                                <input type="search" class="form-control  " placeholder="Search by name..." />
                           </div>
                            <button class="btn btn-secondary py-2 col-sm-3">Search</button>
                       </div>
                    </form>
                    <a class="btn btn-primary text-capitalize col-12 col-sm-2  py-2" asp-action="Create">
                        <i class="fas fa-plus"></i>
                        Create Employee
                    </a>
                </div>
          </div>
          <div class="table-responsive">
                <table class=" text-center align-middle table table-dark table-hover table-striped  table-bordered ">

                    <thead class="table-light fw-bold">
                        <tr>
                            <td>Name</td>
                            <td>Age</td>
                            <td>Email</td>
                            <td style="width:150px">Address</td>
                            <td>Phone</td>
                            <td>Salary</td>
                            <td>IsActivated</td>
                            <td>IsDeleted</td>
                            <td>@Html.DisplayNameFor(e => e.HiringDate)</td>
                            <td>@Html.DisplayNameFor(e => e.CreatedAt)</td>
                            <td>@Html.DisplayNameFor(e => e.Department.Name)</td>
                            <th style="width: 150px;">Details</th>
                            <th style="width: 150px;">Update</th>
                            <th style="width: 150px;">Delete</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Name</td>
                                <td>@item.Age</td>
                                <td>@item.Email</td>
                                <td style="width:150px;">@item.Address</td>
                                <td>@item.Phone</td>
                                <td>@item.Salary</td>
                                <td>@item.IsActivated</td>
                                <td>@item.IsDeleted</td>
                                <td>@item.HiringDate.Month-@item.HiringDate.Year</td>
                                <td>@item.CreatedAt.Month-@item.CreatedAt.Year</td>
                                @* <td>@item.Department?.Name</td> *@

                                @if (item.Department?.Name is null)
                                {
                                    <td>No Department</td>
                                }
                                else
                                {
                                    <td>@item.Department.Name</td>
                                }

                                <partial name="_ButtonsPartialView" model="@item.Id" />
                                @* <td>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-warning">

                                    Details
                                </a>
                            </td>
                            <td>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-success">

                                    Edit
                                </a>
                            </td>
                            <td>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger">

                                    Delete
                                </a>
                            </td> *@
                            </tr>
                        }
                    </tbody>
                </table>
          </div>
        </div>
    }
    else
    {
        <div class="card text-center shadow-sm p-5  mt-5 pt-3">
            <div class="card-body">
                <i class="fa-solid fa-face-sad-cry  fa-4x text-secondary mb-3"></i>
                <h4 class="fw-bold text-muted">No Employee Found</h4>
                <p class="text-muted">It looks like you haven’t added any employees yet.</p>
                <a asp-action="Create" class="btn btn-primary mt-3">
                    <i class="fa-solid fa-plus"></i> Create Employee
                </a>
            </div>
        </div>
    }



</section>

