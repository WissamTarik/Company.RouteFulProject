@model UserToReturnDto
@{
    ViewData["Title"] = "Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Users Details</h1>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-lg border-0 rounded-3">
                <div class="card-header bg-dark text-white text-center">
                    <h4>User @Model.UserName Details</h4>
                </div>
                <div class="card-body">
                    <div>

                        <partial name="UsersPartialView/DeleteAndDetailsPartialView">

                      
          
                        <div class="d-grid">
                            <a class="btn btn-warning" asp-action="Edit" asp-route-id="@ViewBag.Id">
                                Edit
                                <i class="fas fa-pen-alt ms-2"></i>

                            </a>
                            <a asp-action="Index" class="btn btn-outline-secondary mt-2">
                                Return to users List

                                <i class="fas fa-arrow-right ms-2"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>