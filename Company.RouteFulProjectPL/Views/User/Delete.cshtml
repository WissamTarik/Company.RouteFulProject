@model UserToReturnDto
@{
    ViewData["Title"] = "Delete";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-lg border-0 rounded-3">
                <div class="card-header bg-dark text-white text-center">
                    <h4> Delete User @Model.UserName</h4>
                </div>

                <div class="card-body">
                    <form asp-action="Delete">


           
                        <partial name="UsersPartialView/DeleteAndDetailsPartialView">




                        <div class="d-grid">
                            <button type="submit" class="btn btn-danger" asp-action="Delete">
                                <i class="fas fa-trash me-3"></i> Delete
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary mt-2">
                                Return to users  List
                                <i class="fas fa-arrow-right ms-2"></i>

                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

