@model ResetPasswordDto
@{
    ViewData["Title"] = "ResetPassword";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="main-agileinfo">
	<div class="agileits-top">
		<div asp-validation-summary="All" class="mb-2  ms-0 text-start text-danger"></div>
		<form asp-action="ResetPassword">
		
		
			<input asp-for="NewPassword" placeholder="Password" required="">
			<span class="text-danger text-start" asp-validation-for=NewPassword"></span>
			<input asp-for="ConfirmPassword" placeholder="Confirm Password" required="">
			<span class="text-danger text-start " asp-validation-for="ConfirmPassword"></span>
			
			<input type="submit" value="Confirm">
		</form>
	
	</div>
</div>

@section Validation {
	<partial name="_ValidationScriptsPartial" />
}

