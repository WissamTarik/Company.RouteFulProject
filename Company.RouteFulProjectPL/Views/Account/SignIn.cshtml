@model SignInDto
@{
    ViewData["Title"] = "SignIn";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<h1>SignIn</h1>
<div class="main-agileinfo">
	<div class="agileits-top">
		<div asp-validation-summary="All" class="mb-2  text-start text-danger"></div>
		<form asp-action="SignIn">
			
			<input asp-for="Email" placeholder="Email" required="">
			<span class="text-danger text-start" asp-validation-for="Email"></span>
			<input asp-for="Password" placeholder="Password" required="">
			<span class="text-danger text-start" asp-validation-for=Password"></span>
		
			<div class="wthree-text">
				<label class="anim">
					<input asp-for="RememberMe" class="checkbox" >
					<span>Remember me</span>
				</label>
				
				<div class="clear"> </div>
			</div>
			<input type="submit" value="SIGNIN">
		</form>
		<p>Don't have an Account? <a asp-action="SignUp"> Register Now!</a></p>
		<p class="text-center"> <a asp-action="ForgetPassword" class="link-underline-light"> Forget Password ?</a></p>
	</div>
</div>

@section Validation {
	<partial name="_ValidationScriptsPartial" />
}
