@model SignUpDto
@{
    ViewData["Title"] = "SignUp";
	Layout = "_AuthLayout";
}


<div class="main-agileinfo">
	<div class="agileits-top">
		<div asp-validation-summary="All" class="mb-2  ms-0 text-start text-danger" ></div>
		<form  asp-action="SignUp">
			<input  asp-for="UserName" placeholder="Username" required="">
			<span class="text-danger" asp-validation-for=UserName"></span>
			<input asp-for="FirstName" placeholder="FirstName.." required="">
			<span class="text-danger" asp-validation-for="FirstName"></span>
			<input asp-for="LastName" placeholder="LastName" required="">
			<span class="text-danger text-start" asp-validation-for=LastName"></span>
			<input asp-for="Email" placeholder="Email" required="">
			<span class="text-danger text-start" asp-validation-for=Email"></span>
			<input asp-for="Password" placeholder="Password" required="">
			<span class="text-danger text-start" asp-validation-for=Password"></span>
			<input asp-for="ConfirmPassword" placeholder="Confirm Password" required="">
			<span class="text-danger text-start " asp-validation-for="ConfirmPassword"></span>
			<div class="wthree-text">
				<label class="anim">
					<input asp-for="IsAgree" class="checkbox" required>
					<span>I Agree To The Terms & Conditions</span>
				</label>
				<span class="text-danger mb-2 text-start" asp-validation-for="IsAgree"></span>
				<div class="clear"> </div>
			</div>
			<input type="submit" value="SIGNUP">
		</form>
		<p>Have an Account? <a asp-action="SignIn"> Sign in Now!</a></p>
	</div>
</div>

@section Validation{
	<partial name="_ValidationScriptsPartial" />
}