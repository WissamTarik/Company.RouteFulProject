@model ForgetPasswordDto
@{
    ViewData["Title"] = "ForgetPassword";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="main-agileinfo">
	<div class="agileits-top">
		<div asp-validation-summary="All" class="mb-2  ms-0 text-start text-danger"></div>
		<form asp-action="SendResetPasswordUrl">
	
			<input asp-for="Email" placeholder="Email" required="">
			<span class="text-danger text-start" asp-validation-for=Email"></span>

			
			<input type="submit" value="Reset Password">
		</form>
	</div>
</div>

@section Validation {
	<partial name="_ValidationScriptsPartial" />
}
