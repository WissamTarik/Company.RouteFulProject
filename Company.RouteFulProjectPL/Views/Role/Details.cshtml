@model RoleToReturnDto
@{
    ViewData["Title"] = "Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-lg border-0 rounded-3">
                <div class="card-header bg-dark text-white text-center">
                    <h4> Details of  Role @Model.Name</h4>
                </div>

                <div class="card-body">
              


                        <div class="form-floating mb-3">
                            <input placeholder="" asp-for="Id" class="form-control" readonly />
                            <label asp-for="Id"></label>
                        </div>
                        <div class="form-floating mb-3">
                            <input placeholder="" asp-for="Name" class="form-control" readonly />
                            <label asp-for="Name"></label>
                        </div>





                        <div class="d-grid">
                            <a  class="btn btn-warning" asp-action="Edit" asp-route-id="@ViewBag.Id">
                                <i class="fas fa-pen-alt me-3"></i> Edit
                            </a>
                            <a asp-action="Index" class="btn btn-outline-secondary mt-2">
                                Return to roles  List
                                <i class="fas fa-arrow-right ms-2"></i>

                            </a>
                        </div>
                  
                </div>
            </div>
        </div>
    </div>
</div>

